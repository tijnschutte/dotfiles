# What the configs in this repo need, nothing else. Install with: brew bundle
tap "felixkratz/formulae", "https://github.com/FelixKratz/homebrew-formulae", trusted: true
tap "narugit/tap", "https://github.com/narugit/homebrew-tap", trusted: true
tap "nikitabobko/tap"

brew "stow"

# shell: zsh/.zshrc
brew "starship"
brew "eza"
brew "zoxide"
brew "fzf"
brew "go"          # .zshrc runs `go env GOPATH` on every shell
brew "python@3.11" # .zshrc puts it first on PATH
brew "tmux"

# nvim
brew "neovim"
brew "ripgrep"
brew "fd"
brew "tree-sitter-cli"
brew "lazygit"     # snacks <leader>gg

# window manager and bar
cask "aerospace"
brew "felixkratz/formulae/sketchybar"
brew "felixkratz/formulae/borders"
brew "narugit/tap/smctemp" # sketchybar temperature item

# apps with config here
cask "ghostty"
cask "zed"

# fonts: sketchybar uses Hack + app font, ghostty uses JetBrains Mono
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-sketchybar-app-font"
